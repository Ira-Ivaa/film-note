# --- Database (Neon serverless Postgres, free tier) -------------------------
# Neon dashboard -> Connection string -> "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Session cookie signing / hashing pepper --------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- TMDB (movie / series / dorama metadata, free) --------------------------
# https://www.themoviedb.org/settings/api -> "API Read Access Token" (v4).
TMDB_ACCESS_TOKEN=""
# Optional v3 fallback, used only when TMDB_ACCESS_TOKEN is empty.
TMDB_API_KEY=""
# Optional: point TMDB at a reverse proxy or mirror. Needed where an ISP blocks
# api.themoviedb.org / image.tmdb.org — such blocks reset the TCP connection,
# which surfaces in the logs as ECONNREFUSED. Defaults are TMDB's own hosts.
# TMDB_BASE_URL="https://api.themoviedb.org/3"
# TMDB_IMAGE_BASE="https://image.tmdb.org/t/p"

# --- Poster uploads ---------------------------------------------------------
# "vercel-blob" in production, "local" for development (writes to public/uploads).
STORAGE_DRIVER="local"
# Vercel dashboard -> Storage -> Blob -> connect to project (auto-injected on Vercel).
BLOB_READ_WRITE_TOKEN=""
